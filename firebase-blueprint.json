{
  "entities": {
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private user profile, immutable Google UID identity, optional unverified phone, FCM token, and cloud backup metadata.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID (immutable identity key)" },
        "username": { "type": "string", "description": "Unique normalized handle without @ (^[a-z0-9._]{3,24}$)" },
        "displayName": { "type": "string", "description": "User display name" },
        "about": { "type": "string", "description": "Status bio text" },
        "phoneNumber": { "type": "string", "description": "Optional informative phone number (never verified or used for identity)" },
        "phoneVerified": { "type": "boolean", "description": "Always false (SMS verification disabled)" },
        "email": { "type": "string", "description": "User email from Google Sign-In" },
        "emailVerificationEnabled": { "type": "boolean", "description": "Toggleable 6-character alphanumeric email verification requirement" },
        "emailCodeVerified": { "type": "boolean", "description": "Whether the primary email was confirmed via the 6-character alphanumeric code" },
        "recoveryEmail": { "type": "string", "description": "Optional secondary recovery email address" },
        "recoveryEmailVerified": { "type": "boolean", "description": "Whether the recovery email was confirmed via the 6-character alphanumeric code" },
        "photoUrl": { "type": "string", "description": "Profile avatar URL (static image, GIF, or looping MP4)" },
        "bannerUrl": { "type": "string", "description": "Profile top banner image, GIF, or MP4 URL" },
        "fcmToken": { "type": "string", "description": "Firebase Cloud Messaging device token" },
        "online": { "type": "boolean", "description": "Current online status" },
        "lastSeen": { "type": "string", "format": "date-time", "description": "Last seen timestamp (FieldValue.serverTimestamp())" },
        "lastBackupUrl": { "type": "string", "description": "Download URL or storage path of latest encrypted ZIP backup" },
        "lastBackupAt": { "type": "string", "format": "date-time", "description": "Timestamp of last cloud backup" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation timestamp (FieldValue.serverTimestamp())" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp (FieldValue.serverTimestamp())" }
      },
      "required": ["uid", "displayName", "online", "createdAt", "updatedAt"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Non-PII public discovery profile (UID, @username, name, avatar, banner, presence) readable by authenticated users.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "username": { "type": "string", "description": "Unique normalized handle without @ (^[a-z0-9._]{3,24}$)" },
        "displayName": { "type": "string", "description": "Display name" },
        "displayNameLower": { "type": "string", "description": "Lowercase display name for prefix search" },
        "about": { "type": "string", "description": "About status line" },
        "photoUrl": { "type": "string", "description": "Avatar URL (static image, GIF, or looping MP4)" },
        "bannerUrl": { "type": "string", "description": "Profile top banner image, GIF, or MP4 URL" },
        "online": { "type": "boolean", "description": "Real-time online indicator" },
        "lastSeen": { "type": "string", "format": "date-time", "description": "Last active timestamp (FieldValue.serverTimestamp())" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp (FieldValue.serverTimestamp())" }
      },
      "required": ["uid", "displayName", "online", "updatedAt"]
    },
    "UsernameLookup": {
      "title": "UsernameLookup",
      "description": "Atomic unique @username reservation index mapping normalized handle to owner UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner Firebase UID" },
        "username": { "type": "string", "description": "Normalized handle matching document ID" },
        "displayName": { "type": "string", "description": "Display name" },
        "photoUrl": { "type": "string", "description": "Avatar URL" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp (FieldValue.serverTimestamp())" }
      },
      "required": ["uid", "username", "displayName", "updatedAt"]
    },
    "EmailLookup": {
      "title": "EmailLookup",
      "description": "Exact lowercase Google email lookup mapping to UID without allowing email list scraping.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner Firebase UID" },
        "username": { "type": "string", "description": "Normalized handle" },
        "displayName": { "type": "string", "description": "Display name" },
        "photoUrl": { "type": "string", "description": "Avatar URL" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp (FieldValue.serverTimestamp())" }
      },
      "required": ["uid", "displayName", "updatedAt"]
    },
    "ContactEntry": {
      "title": "ContactEntry",
      "description": "User's saved contact linking a searched Zap2 user to their immutable UID.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "description": "Owner UID" },
        "peerUid": { "type": "string", "description": "Target user UID" },
        "username": { "type": "string", "description": "Peer normalized @username" },
        "displayName": { "type": "string", "description": "Contact display name" },
        "phoneNumber": { "type": "string", "description": "Optional informative phone number" },
        "photoUrl": { "type": "string", "description": "Contact avatar URL" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp (FieldValue.serverTimestamp())" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp (FieldValue.serverTimestamp())" }
      },
      "required": ["ownerId", "peerUid", "displayName", "createdAt", "updatedAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Direct 1-on-1 or Group conversation.",
      "type": "object",
      "properties": {
        "chatType": { "type": "string", "enum": ["DIRECT", "GROUP"], "description": "Conversation type" },
        "title": { "type": "string", "description": "Group name or direct chat label" },
        "description": { "type": "string", "description": "Group description" },
        "groupPhotoUrl": { "type": "string", "description": "Group avatar URL" },
        "createdBy": { "type": "string", "description": "Creator UID" },
        "participantUids": { "type": "array", "description": "Participant UIDs (max 50)" },
        "adminUids": { "type": "array", "description": "Admin UIDs (max 50)" },
        "participantNames": { "type": "object", "description": "Map of UID to display name" },
        "lastMessageText": { "type": "string", "description": "Latest message preview text" },
        "lastMessageType": { "type": "string", "enum": ["TEXT", "IMAGE", "GIF", "STICKER", "GIF_AUDIO", "VIDEO", "AUDIO", "PDF", "APK", "ZIP", "FILE", "SYSTEM"], "description": "Latest message type" },
        "lastMessageSenderId": { "type": "string", "description": "Sender UID of latest message" },
        "lastMessageAt": { "type": "string", "format": "date-time", "description": "Latest message timestamp (FieldValue.serverTimestamp())" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp (FieldValue.serverTimestamp())" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp (FieldValue.serverTimestamp())" }
      },
      "required": [
        "chatType",
        "title",
        "createdBy",
        "participantUids",
        "adminUids",
        "lastMessageText",
        "lastMessageType",
        "lastMessageSenderId",
        "lastMessageAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "Message": {
      "title": "Message",
      "description": "Real-time text, media, GIF, sticker, GIF+audio, view-once, document, or system message in a chat.",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "description": "Parent chat ID" },
        "senderId": { "type": "string", "description": "Sender UID" },
        "senderName": { "type": "string", "description": "Sender display name" },
        "participantUids": { "type": "array", "description": "Denormalized chat participant UIDs" },
        "messageType": { "type": "string", "enum": ["TEXT", "IMAGE", "GIF", "STICKER", "GIF_AUDIO", "VIDEO", "AUDIO", "PDF", "APK", "ZIP", "FILE", "SYSTEM"], "description": "Message payload type" },
        "text": { "type": "string", "description": "Message text body or caption" },
        "mediaUrl": { "type": "string", "description": "Download URL or chunk URI for media, GIF, sticker, and files" },
        "localMediaPath": { "type": "string", "description": "Local cached filename reference" },
        "mediaDurationMs": { "type": "integer", "description": "Audio or video duration in milliseconds" },
        "fileName": { "type": "string", "description": "Original filename of uploaded media or document" },
        "fileSizeBytes": { "type": "integer", "description": "File size in bytes" },
        "mimeType": { "type": "string", "description": "MIME type of uploaded media or document" },
        "audioUrl": { "type": "string", "description": "Paired audio URL or chunk URI for GIF_AUDIO messages" },
        "audioFileName": { "type": "string", "description": "Filename of paired audio track" },
        "audioMimeType": { "type": "string", "description": "MIME type of paired audio track" },
        "localAudioPath": { "type": "string", "description": "Local cached filename for paired audio" },
        "viewOnce": { "type": "boolean", "description": "Whether message can only be opened once per recipient" },
        "viewedBy": { "type": "array", "description": "UIDs that opened this view-once message" },
        "deliveredTo": { "type": "array", "description": "UIDs that received the message" },
        "readBy": { "type": "array", "description": "UIDs that read the message" },
        "edited": { "type": "boolean", "description": "Whether message text was edited by sender" },
        "editedAt": { "type": "string", "format": "date-time", "description": "Edit timestamp (FieldValue.serverTimestamp())" },
        "deletedFor": { "type": "array", "description": "UIDs that deleted this message only for themselves" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Send timestamp (FieldValue.serverTimestamp())" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp (FieldValue.serverTimestamp())" }
      },
      "required": ["chatId", "senderId", "senderName", "participantUids", "messageType", "text", "createdAt", "updatedAt"]
    },
    "TypingStatus": {
      "title": "TypingStatus",
      "description": "Real-time typing indicator per participant inside a chat.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Typing user UID" },
        "displayName": { "type": "string", "description": "Typing user display name" },
        "participantUids": { "type": "array", "description": "Denormalized chat participant UIDs" },
        "typing": { "type": "boolean", "description": "True while actively typing" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp (FieldValue.serverTimestamp())" }
      },
      "required": ["uid", "displayName", "participantUids", "typing", "updatedAt"]
    },
    "CallSession": {
      "title": "CallSession",
      "description": "WebRTC voice/video call signaling session.",
      "type": "object",
      "properties": {
        "callerId": { "type": "string", "description": "Caller UID" },
        "callerName": { "type": "string", "description": "Caller display name" },
        "calleeId": { "type": "string", "description": "Callee UID" },
        "calleeName": { "type": "string", "description": "Callee display name" },
        "chatId": { "type": "string", "description": "Associated chat ID" },
        "participantUids": { "type": "array", "description": "Caller and callee UIDs" },
        "callType": { "type": "string", "enum": ["AUDIO", "VIDEO"], "description": "Call media type" },
        "status": { "type": "string", "enum": ["RINGING", "CONNECTED", "ENDED", "DECLINED", "MISSED"], "description": "Call lifecycle state" },
        "offerSdp": { "type": "string", "description": "WebRTC SDP offer" },
        "answerSdp": { "type": "string", "description": "WebRTC SDP answer" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Call initiation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last signaling update timestamp" }
      },
      "required": ["callerId", "callerName", "calleeId", "calleeName", "chatId", "participantUids", "callType", "status", "createdAt", "updatedAt"]
    },
    "IceCandidate": {
      "title": "IceCandidate",
      "description": "WebRTC ICE candidate exchanged via Firestore subcollections.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string", "description": "Sender UID" },
        "participantUids": { "type": "array", "description": "Call participant UIDs" },
        "sdpMid": { "type": "string", "description": "ICE sdpMid" },
        "sdpMLineIndex": { "type": "integer", "description": "ICE m-line index" },
        "sdp": { "type": "string", "description": "ICE candidate SDP string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["senderId", "participantUids", "sdpMid", "sdpMLineIndex", "sdp", "createdAt"]
    },
    "ChatFileChunk": {
      "title": "ChatFileChunk",
      "description": "Free chunked Base64 file block stored in Firestore for Spark-plan chats.",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "description": "Parent chat ID" },
        "fileId": { "type": "string", "description": "Logical file identifier" },
        "chunkIndex": { "type": "integer", "description": "Zero-based chunk index" },
        "totalChunks": { "type": "integer", "description": "Total chunk count" },
        "senderId": { "type": "string", "description": "Uploader UID" },
        "participantUids": { "type": "array", "description": "Denormalized chat participant UIDs" },
        "data": { "type": "string", "description": "Base64 encoded chunk payload" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Upload timestamp" }
      },
      "required": ["chatId", "fileId", "chunkIndex", "totalChunks", "senderId", "participantUids", "data", "createdAt"]
    },
    "PublicMediaChunk": {
      "title": "PublicMediaChunk",
      "description": "Free chunked Base64 profile banner or animated avatar block.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "description": "Owner UID" },
        "mediaId": { "type": "string", "description": "Logical media identifier" },
        "chunkIndex": { "type": "integer", "description": "Zero-based chunk index" },
        "totalChunks": { "type": "integer", "description": "Total chunk count" },
        "mimeType": { "type": "string", "description": "Media MIME type" },
        "data": { "type": "string", "description": "Base64 encoded chunk payload" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Upload timestamp" }
      },
      "required": ["ownerId", "mediaId", "chunkIndex", "totalChunks", "mimeType", "data", "createdAt"]
    },
    "BackupChunk": {
      "title": "BackupChunk",
      "description": "Free chunked Base64 encrypted ZIP backup block.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "description": "Owner UID" },
        "backupId": { "type": "string", "description": "Backup archive identifier" },
        "chunkIndex": { "type": "integer", "description": "Zero-based chunk index" },
        "totalChunks": { "type": "integer", "description": "Total chunk count" },
        "data": { "type": "string", "description": "Base64 encoded chunk payload" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Upload timestamp" }
      },
      "required": ["ownerId", "backupId", "chunkIndex", "totalChunks", "data", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Owner-only user profile and private account metadata"
    },
    "/public_profiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Public non-PII profile readable and searchable by authenticated users"
    },
    "/username_lookup/{usernameKey}": {
      "schema": { "$ref": "#/entities/UsernameLookup" },
      "description": "Unique @username index mapping normalized handle to UID"
    },
    "/email_lookup/{emailKey}": {
      "schema": { "$ref": "#/entities/EmailLookup" },
      "description": "Exact lowercase Google email lookup mapping to UID (no listing allowed)"
    },
    "/users/{userId}/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/ContactEntry" },
      "description": "Owner's saved contacts subcollection"
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/Chat" },
      "description": "Direct and group chats scoped by participantUids"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Chat messages subcollection with denormalized participantUids"
    },
    "/chats/{chatId}/typing/{typingUid}": {
      "schema": { "$ref": "#/entities/TypingStatus" },
      "description": "Real-time typing indicator per participant"
    },
    "/calls/{callId}": {
      "schema": { "$ref": "#/entities/CallSession" },
      "description": "WebRTC voice/video call signaling sessions"
    },
    "/calls/{callId}/callerCandidates/{candId}": {
      "schema": { "$ref": "#/entities/IceCandidate" },
      "description": "Caller ICE candidates"
    },
    "/calls/{callId}/calleeCandidates/{candId}": {
      "schema": { "$ref": "#/entities/IceCandidate" },
      "description": "Callee ICE candidates"
    },
    "/chats/{chatId}/file_chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/ChatFileChunk" },
      "description": "Participant-scoped free chunked file storage"
    },
    "/public_media_chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/PublicMediaChunk" },
      "description": "Free chunked profile media (banner and animated avatar) readable by exact chunk ID"
    },
    "/users/{userId}/backup_chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/BackupChunk" },
      "description": "Owner-only free chunked cloud ZIP backup storage"
    }
  }
}
